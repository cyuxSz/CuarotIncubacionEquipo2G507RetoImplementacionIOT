<?xml version="1.0" encoding="UTF-8"?>
<module fritzingVersion="0.9.4" moduleId="argos_dht22_3p">
 <version>1</version>
 <author>Argos (Equipo G507)</author>
 <title>DHT22 módulo de 3 pines</title>
 <label>U</label>
 <date>2026-10-23</date>
 <tags><tag>Argos</tag></tags>
 <properties>
  <property name="family">Argos</property>
  <property name="variant">DHT22 3 pines</property>
 </properties>
 <description>Módulo DHT22 (AM2302) en placa morada con pull-up propio; pines + out -.</description>
 <views>
  <iconView><layers image="icon/argos_dht22_3p_breadboard.svg"><layer layerId="icon"/></layers></iconView>
  <breadboardView><layers image="breadboard/argos_dht22_3p_breadboard.svg"><layer layerId="breadboard"/></layers></breadboardView>
  <schematicView><layers image="schematic/argos_dht22_3p_schematic.svg"><layer layerId="schematic"/></layers></schematicView>
  <pcbView><layers image="pcb/argos_dht22_3p_pcb.svg"><layer layerId="copper0"/><layer layerId="copper1"/></layers></pcbView>
 </views>
 <connectors>
  <connector id="connector0" name="VCC" type="male">
   <description>VCC</description>
   <views>
    <breadboardView><p layer="breadboard" svgId="connector0pin"/></breadboardView>
    <schematicView><p layer="schematic" svgId="connector0pin" terminalId="connector0terminal"/></schematicView>
    <pcbView><p layer="copper0" svgId="connector0pad"/><p layer="copper1" svgId="connector0pad"/></pcbView>
   </views>
  </connector>
  <connector id="connector1" name="DATA" type="male">
   <description>DATA</description>
   <views>
    <breadboardView><p layer="breadboard" svgId="connector1pin"/></breadboardView>
    <schematicView><p layer="schematic" svgId="connector1pin" terminalId="connector1terminal"/></schematicView>
    <pcbView><p layer="copper0" svgId="connector1pad"/><p layer="copper1" svgId="connector1pad"/></pcbView>
   </views>
  </connector>
  <connector id="connector2" name="GND" type="male">
   <description>GND</description>
   <views>
    <breadboardView><p layer="breadboard" svgId="connector2pin"/></breadboardView>
    <schematicView><p layer="schematic" svgId="connector2pin" terminalId="connector2terminal"/></schematicView>
    <pcbView><p layer="copper0" svgId="connector2pad"/><p layer="copper1" svgId="connector2pad"/></pcbView>
   </views>
  </connector>
 </connectors>
</module>
