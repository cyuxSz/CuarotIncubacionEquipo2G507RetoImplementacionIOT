 "cards": [
  {
   "dot": "emerald",
   "title": "Qué viaja por MQTT",
   "items": [
    "telemetria: T y HR cada 30 s; luz cada 60 s",
    "evento: movimiento, golpe, puerta, sensor_error",
    "estado: online/offline con LWT a los 45 s",
    "cmd/alarma: n8n repite on cada 60 s al nodo dht"
   ]
  },
  {
   "dot": "amber",
   "title": "Cuándo se avisa",
   "items": [
    "3 lecturas seguidas fuera de 22–28 °C o 40–60 % HR",
    "Cierra con histéresis de 0.5 °C o 2 % HR",
    "El dht suena por su cuenta aunque se caiga la red"
   ]
  },
  {
   "dot": "cyan",
   "title": "Web API (webhooks de n8n)",
   "items": [
    "GET /api/estado: último valor y estado de cada nodo",
    "GET /api/mediciones: historial por nodo y parámetro",
    "GET /api/alertas: alertas activas o todas",
    "Clave en la cabecera X-API-Key; solo lectura sobre MySQL"
   ]
  },
  {
   "dot": "slate",
   "title": "Qué no hace",
   "items": [
    "No controla el minisplit ni las lámparas",
    "Los nodos no tienen reloj: MySQL pone la hora"
   ]
  }
 ]
