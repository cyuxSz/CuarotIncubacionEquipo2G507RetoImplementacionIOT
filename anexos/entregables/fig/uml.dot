graph G {
graph [layout=neato, splines=line, overlap=true, fontname="Arial", pad=0.2];
node [shape=plain, fontname="Arial", fontsize=13];
edge [fontname="Arial", fontsize=12, labeldistance=1.8, labelangle=35];
