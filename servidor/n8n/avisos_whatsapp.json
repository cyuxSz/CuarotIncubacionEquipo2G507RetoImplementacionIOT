      "id": "a1000000-0000-4000-8000-000000000002",
      "name": "Configuracion",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [
        220,
        0
      ],
      "notes": "Lo unico que se edita: api_key, callmebot_telefono y callmebot_apikey. n8n corre en el mismo servidor que el central (localhost:3000). No exportes este flujo a git con los valores llenos."
    },
    {
      "parameters": {
        "url": "={{ $json.api_url }}/api/notificaciones/pendientes?canal=whatsapp",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "X-API-Key",
              "value": "={{ $json.api_key }}"
            }
          ]
        },
        "options": {
          "timeout": 10000
        }
      },
      "id": "a1000000-0000-4000-8000-000000000003",
      "name": "Leer pendientes",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        440,
        0
      ]
    },
    {
      "parameters": {
        "jsCode": "// Arma UN mensaje de WhatsApp (CallMeBot) con todos los avisos graves pendientes.\n// De noche (fuera de hora_inicio..hora_fin, hora de Monterrey) no manda nada: los avisos se quedan\n// pendientes y salen juntos, como resumen, en la primera vuelta despues de hora_inicio.\nconst CANAL = 'whatsapp';\nconst cfg = $('Configuracion').first().json;\nconst pendientes = ($input.first().json.pendientes ?? []).filter((p) => p.canal === CANAL);\nconst hora = Number(new Intl.DateTimeFormat('en-US', { timeZone: 'America/Monterrey', hour: 'numeric', hourCycle: 'h23' }).format(new Date()));\nif (pendientes.length === 0 || hora < cfg.hora_inicio || hora >= cfg.hora_fin) return [];\n\nconst NOMBRE = { temperatura: 'Temperatura fuera de rango', humedad: 'Humedad fuera de rango', puerta_abierta: 'Puerta abierta de mas', nodo_sin_reporte: 'Nodo sin reportar', sensor_falla: 'Falla de sensor', golpe: 'Golpe en el anaquel', movimiento_fuera_de_horario: 'Movimiento fuera de horario', luz: 'Luz fuera de horario' };\nconst UNIDAD = { temperatura: ' C', humedad: ' % HR' };\nconst fmt = new Intl.DateTimeFormat('es-MX', { timeZone: 'America/Monterrey', day: 'numeric', month: 'short', hour: '2-digit', minute: '2-digit', hourCycle: 'h23' });\nconst lineas = pendientes.map((p) => {\n  const valor = UNIDAD[p.tipo] && p.valor !== null ? ' (' + p.valor + UNIDAD[p.tipo] + ')' : '';\n  const estado = p.ts_fin ? 'ya se resolvio' : 'SIGUE ACTIVA';\n  return '- ' + (NOMBRE[p.tipo] ?? p.tipo) + valor + ', nodo ' + p.id_nodo + ', desde ' + fmt.format(new Date(p.ts_inicio)) + ': ' + estado;\n});\nconst titulo = pendientes.length === 1 ? 'ARGOS - alerta grave en el cuarto de incubacion' : 'ARGOS - ' + pendientes.length + ' alertas graves en el cuarto de incubacion';\nreturn [{ json: { canal: CANAL, ids: pendientes.map((p) => p.id_alerta), texto: titulo + '\\n' + lineas.join('\\n') } }];"
      },
      "id": "a1000000-0000-4000-8000-000000000007",
      "name": "Aviso WhatsApp",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        660,
        0
      ]
    },
    {
      "parameters": {
        "url": "https://api.callmebot.com/whatsapp.php",
        "sendQuery": true,
        "queryParameters": {
          "parameters": [
            {
              "name": "phone",
              "value": "={{ $('Configuracion').first().json.callmebot_telefono }}"
            },
            {
              "name": "text",
              "value": "={{ $json.texto }}"
            },
            {
              "name": "apikey",
              "value": "={{ $('Configuracion').first().json.callmebot_apikey }}"
            }
          ]
        },
        "options": {
          "timeout": 20000
        }
      },
      "id": "a1000000-0000-4000-8000-000000000008",
      "name": "Mandar WhatsApp",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "onError": "continueErrorOutput",
      "position": [
        880,
        0
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $('Configuracion').first().json.api_url }}/api/notificaciones/enviadas",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "X-API-Key",
              "value": "={{ $('Configuracion').first().json.api_key }}"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ ids: $('Aviso WhatsApp').first().json.ids, canal: 'whatsapp' }) }}",
        "options": {
          "timeout": 10000
        }
      },
      "id": "a1000000-0000-4000-8000-000000000009",
      "name": "Marcar WhatsApp",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1100,
        0
      ]
    }
  ],
